// wrangler.jsonc
// Tells Cloudflare Workers how to host this site:
// serve the static files that "npm run build" puts in the out/ folder.
{
  "name": "aiscientificlabs-site",        // must match the project name in Cloudflare
  "compatibility_date": "2025-10-01",     // Cloudflare runtime version to use
  "build": {
    // wrangler deploy runs this first, so the site is built even if
    // the Cloudflare "Build command" field is empty
    "command": "npm ci && npm run build"
  },
  "routes": [
    // connect the real domain; Cloudflare creates the DNS records and SSL certificate
    { "pattern": "aiscientificlabs.com", "custom_domain": true },
    { "pattern": "www.aiscientificlabs.com", "custom_domain": true }
  ],
  "assets": {
    "directory": "./out",                 // the folder Next.js static export creates
    "not_found_handling": "404-page"      // show the site's 404 page for unknown URLs
  }
}